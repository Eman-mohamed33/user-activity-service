{
  "info": {
    "name": "User Activity Service",
    "description": "Requests for the TypeScript event-driven user activity service. Start the service with npm run start before using this collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "userId",
      "value": "user-123"
    },
    {
      "key": "eventType",
      "value": "login"
    },
    {
      "key": "eventId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        }
      },
      "response": []
    },
    {
      "name": "Publish Activity Event",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Response is 202 Accepted', function () {",
              "    pm.response.to.have.status(202);",
              "});",
              "const response = pm.response.json();",
              "if (response.eventId) {",
              "    pm.collectionVariables.set('eventId', response.eventId);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"eventType\": \"{{eventType}}\",\n  \"metadata\": {\n    \"source\": \"postman\"\n  },\n  \"occurredAt\": \"2026-09-20T10:00:00.000Z\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/events",
          "host": ["{{baseUrl}}"],
          "path": ["api", "events"]
        }
      },
      "response": []
    },
    {
      "name": "Publish Invalid Event",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Response is 400 Bad Request', function () {",
              "    pm.response.to.have.status(400);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"eventType\": \"login\",\n  \"occurredAt\": \"not-a-date\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/events",
          "host": ["{{baseUrl}}"],
          "path": ["api", "events"]
        }
      },
      "response": []
    },
    {
      "name": "List Logs - Default Page",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/logs",
          "host": ["{{baseUrl}}"],
          "path": ["api", "logs"]
        }
      },
      "response": []
    },
    {
      "name": "List Logs - Filter by User",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/logs?userId={{userId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "logs"],
          "query": [
            {
              "key": "userId",
              "value": "{{userId}}"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "List Logs - Filter by Type and Date",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/logs?eventType={{eventType}}&from=2026-01-01&to=2026-12-31",
          "host": ["{{baseUrl}}"],
          "path": ["api", "logs"],
          "query": [
            {
              "key": "eventType",
              "value": "{{eventType}}"
            },
            {
              "key": "from",
              "value": "2026-01-01"
            },
            {
              "key": "to",
              "value": "2026-12-31"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "List Logs - Pagination",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/logs?page=1&limit=5",
          "host": ["{{baseUrl}}"],
          "path": ["api", "logs"],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "5"
            }
          ]
        }
      },
      "response": []
    }
  ]
}
